{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile storing active farm workspace and role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "activeFarmId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "activeRole": {
          "type": "string",
          "enum": ["manager", "worker"]
        },
        "activeMemberId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "activeFarmName": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "activeFarmId",
        "activeRole",
        "activeMemberId",
        "activeFarmName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Farm": {
      "title": "Farm",
      "description": "Root farm operations workspace owning plants, animals, fish tanks, people, and schedules.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "volumeUnit": {
          "type": "string",
          "enum": ["L", "gal"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "location", "volumeUnit", "createdAt", "updatedAt"]
    },
    "FarmInvite": {
      "title": "FarmInvite",
      "description": "Single-use invite code allowing a farm worker with their own Google account to join a manager's farm.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "farmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "farmName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["open", "claimed"]
        },
        "claimedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "initialPlantIds": {
          "type": "array",
          "description": "Up to 10 plant IDs initially assigned to this worker."
        },
        "initialTankIds": {
          "type": "array",
          "description": "Up to 10 fish tank IDs initially assigned to this worker."
        },
        "initialAnimalTaskIds": {
          "type": "array",
          "description": "Up to 10 animal task IDs initially assigned to this worker."
        },
        "initialCustomTaskIds": {
          "type": "array",
          "description": "Up to 10 custom task IDs initially assigned to this worker."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "farmId",
        "farmName",
        "ownerId",
        "memberId",
        "memberName",
        "status",
        "claimedByUid",
        "initialPlantIds",
        "initialTankIds",
        "initialAnimalTaskIds",
        "initialCustomTaskIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "FarmMember": {
      "title": "FarmMember",
      "description": "Person working on the farm who can be assigned tasks and optionally sign in via invite code.",
      "type": "object",
      "properties": {
        "farmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["manager", "worker"]
        },
        "specialty": {
          "type": "string",
          "maxLength": 100
        },
        "linkedUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Z0-9]*$"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "farmId",
        "ownerId",
        "name",
        "role",
        "specialty",
        "linkedUid",
        "inviteCode",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlantSchedule": {
      "title": "PlantSchedule",
      "description": "Plant or crop bed with recurring watering, mulching, and pruning schedules and assignees.",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "zone": { "type": "string", "minLength": 1, "maxLength": 60 },
        "category": { "type": "string", "enum": ["vegetable", "herb", "fruit", "orchard", "nursery"] },
        "waterEnabled": { "type": "boolean" },
        "waterEveryDays": { "type": "integer" },
        "lastWateredDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "waterAssigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "waterAssigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "mulchEnabled": { "type": "boolean" },
        "mulchEveryDays": { "type": "integer" },
        "lastMulchedDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "mulchAssigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "mulchAssigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "pruneEnabled": { "type": "boolean" },
        "pruneEveryDays": { "type": "integer" },
        "lastPrunedDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "pruneAssigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "pruneAssigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "receivesFishWater": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "farmId", "ownerId", "name", "zone", "category",
        "waterEnabled", "waterEveryDays", "lastWateredDate", "waterAssigneeId", "waterAssigneeUid",
        "mulchEnabled", "mulchEveryDays", "lastMulchedDate", "mulchAssigneeId", "mulchAssigneeUid",
        "pruneEnabled", "pruneEveryDays", "lastPrunedDate", "pruneAssigneeId", "pruneAssigneeUid",
        "receivesFishWater", "notes", "createdAt", "updatedAt"
      ]
    },
    "FishTank": {
      "title": "FishTank",
      "description": "Aquaculture fish tank following the 1/4, 2/4, 3/4 stepped water change cycle for irrigation.",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "species": { "type": "string", "minLength": 1, "maxLength": 80 },
        "capacityLiters": { "type": "integer" },
        "intervalDays": { "type": "integer" },
        "currentStage": { "type": "integer", "enum": [1, 2, 3] },
        "nextDrawdownDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "lastDrawdownDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "assigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "assigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "irrigationBedIds": { "type": "array", "description": "Up to 10 plant document IDs irrigated with discharged fish tank water." },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "farmId", "ownerId", "name", "species", "capacityLiters", "intervalDays",
        "currentStage", "nextDrawdownDate", "lastDrawdownDate",
        "assigneeId", "assigneeUid", "irrigationBedIds", "notes", "createdAt", "updatedAt"
      ]
    },
    "AnimalGroup": {
      "title": "AnimalGroup",
      "description": "Livestock or aquaculture animal group on the animal farm (fish, chickens, ducks, goats, etc.).",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "animalType": { "type": "string", "enum": ["fish", "chicken", "duck", "goat", "pig", "cattle", "other"] },
        "count": { "type": "integer" },
        "housing": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["farmId", "ownerId", "name", "animalType", "count", "housing", "notes", "createdAt", "updatedAt"]
    },
    "AnimalTask": {
      "title": "AnimalTask",
      "description": "Recurring animal care activity (feeding catfish, cleaning chicken coop, refreshing duck water, etc.).",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "animalId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "animalName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "animalType": { "type": "string", "enum": ["fish", "chicken", "duck", "goat", "pig", "cattle", "other"] },
        "taskKind": { "type": "string", "enum": ["feeding", "cleaning", "water_change", "egg_collection", "health_check", "other"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "everyDays": { "type": "integer" },
        "lastDoneDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "assigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "assigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "farmId", "ownerId", "animalId", "animalName", "animalType", "taskKind",
        "title", "everyDays", "lastDoneDate", "assigneeId", "assigneeUid", "notes",
        "createdAt", "updatedAt"
      ]
    },
    "CustomTask": {
      "title": "CustomTask",
      "description": "One-time or recurring custom farm task assigned to a person.",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["water", "mulch", "prune", "fish_tank", "animal", "harvest", "maintenance"] },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "recurrenceDays": { "type": "integer" },
        "assigneeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "assigneeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "completedDate": { "type": "string", "maxLength": 10, "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "farmId", "ownerId", "title", "category", "dueDate", "recurrenceDays",
        "assigneeId", "assigneeUid", "status", "completedDate", "notes", "createdAt", "updatedAt"
      ]
    },
    "CompletionLog": {
      "title": "CompletionLog",
      "description": "Daily task completion submission with mandatory manager confirmation for worker completions.",
      "type": "object",
      "properties": {
        "farmId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "taskType": { "type": "string", "enum": ["water", "mulch", "prune", "fish_tank", "animal", "custom"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "assignedMemberId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "assignedMemberName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "assignedUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "completedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "completedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["done"] },
        "approvalStatus": { "type": "string", "enum": ["pending_confirmation", "confirmed"] },
        "confirmedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "confirmedByName": { "type": "string", "maxLength": 80 },
        "waterVolumeLiters": { "type": "integer" },
        "tankStage": { "type": "string", "enum": ["", "1/4", "2/4", "3/4"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "farmId", "ownerId", "dateKey", "taskType", "sourceId", "sourceTitle",
        "assignedMemberId", "assignedMemberName", "assignedUid",
        "completedByUid", "completedByName", "status",
        "approvalStatus", "confirmedByUid", "confirmedByName",
        "waterVolumeLiters", "tankStage", "notes", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private authenticated user profile storing active farm workspace and role."
    },
    "/farmInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/FarmInvite" },
      "description": "Single-use invite codes allowing workers to join a manager's farm."
    },
    "/farms/{farmId}": {
      "schema": { "$ref": "#/entities/Farm" },
      "description": "Farm workspace root document."
    },
    "/farms/{farmId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FarmMember" },
      "description": "Farm crew members assignable to plant and animal tasks."
    },
    "/farms/{farmId}/plants/{plantId}": {
      "schema": { "$ref": "#/entities/PlantSchedule" },
      "description": "Plant and crop bed schedules for watering, mulching, and pruning."
    },
    "/farms/{farmId}/fishTanks/{tankId}": {
      "schema": { "$ref": "#/entities/FishTank" },
      "description": "Aquaculture fish tanks with 1/4, 2/4, 3/4 stepped water change cycles."
    },
    "/farms/{farmId}/animals/{animalId}": {
      "schema": { "$ref": "#/entities/AnimalGroup" },
      "description": "Animal groups on the animal farm (fish, chickens, ducks, goats, etc.)."
    },
    "/farms/{farmId}/animalTasks/{taskId}": {
      "schema": { "$ref": "#/entities/AnimalTask" },
      "description": "Recurring animal care tasks (feeding, cleaning, water changes, egg collection)."
    },
    "/farms/{farmId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CustomTask" },
      "description": "Custom one-off or recurring farm tasks."
    },
    "/farms/{farmId}/completions/{completionId}": {
      "schema": { "$ref": "#/entities/CompletionLog" },
      "description": "Daily task completion log with manager confirmation workflow."
    }
  }
}
