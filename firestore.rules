rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net — default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitives & Hardened Validation Helpers
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptionalId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]*$');
    }

    function isInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isOptionalInviteCode(code) {
      return code is string && code.size() <= 16 && code.matches('^[A-Z0-9]*$');
    }

    function isDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDateString(val) {
      return val is string && val.size() <= 10 && val.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$');
    }

    function farmExists(farmId) {
      return exists(/databases/$(database)/documents/farms/$(farmId));
    }

    function getFarm(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data;
    }

    function isFarmOwner(farmId) {
      return farmExists(farmId) && getFarm(farmId).ownerId == request.auth.uid;
    }

    function isActiveLinkedMember(farmId, memberId) {
      return isValidId(memberId)
        && exists(/databases/$(database)/documents/farms/$(farmId)/members/$(memberId))
        && get(/databases/$(database)/documents/farms/$(farmId)/members/$(memberId)).data.linkedUid == request.auth.uid
        && get(/databases/$(database)/documents/farms/$(farmId)/members/$(memberId)).data.active == true;
    }

    function isValidBoundedIdList(listVal) {
      return listVal is list
        && listVal.size() <= 10
        && (listVal.size() == 0 || isValidId(listVal[0]));
    }

    // =========================================================================
    // Entity Validation Blueprints (Aligned 1:1 with firebase-blueprint.json)
    // =========================================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'activeFarmId', 'activeRole', 'activeMemberId', 'activeFarmName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'activeFarmId', 'activeRole', 'activeMemberId', 'activeFarmName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isOptionalId(data.activeFarmId)
        && data.activeRole in ['manager', 'worker']
        && isOptionalId(data.activeMemberId)
        && data.activeFarmName is string && data.activeFarmName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFarm(data) {
      return data.keys().hasAll(['ownerId', 'name', 'location', 'volumeUnit', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'location', 'volumeUnit', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.location is string && data.location.size() <= 120
        && data.volumeUnit in ['L', 'gal']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFarmInvite(data, inviteCode) {
      return data.keys().hasAll([
          'code', 'farmId', 'farmName', 'ownerId', 'memberId', 'memberName',
          'status', 'claimedByUid', 'initialPlantIds', 'initialTankIds',
          'initialAnimalTaskIds', 'initialCustomTaskIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'farmId', 'farmName', 'ownerId', 'memberId', 'memberName',
          'status', 'claimedByUid', 'initialPlantIds', 'initialTankIds',
          'initialAnimalTaskIds', 'initialCustomTaskIds', 'createdAt', 'updatedAt'
        ])
        && isInviteCode(data.code) && data.code == inviteCode
        && isValidId(data.farmId)
        && data.farmName is string && data.farmName.size() >= 1 && data.farmName.size() <= 80
        && isValidId(data.ownerId)
        && isValidId(data.memberId)
        && data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 80
        && data.status in ['open', 'claimed']
        && isOptionalId(data.claimedByUid)
        && isValidBoundedIdList(data.initialPlantIds)
        && isValidBoundedIdList(data.initialTankIds)
        && isValidBoundedIdList(data.initialAnimalTaskIds)
        && isValidBoundedIdList(data.initialCustomTaskIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFarmMember(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'name', 'role', 'specialty', 'linkedUid', 'inviteCode', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'name', 'role', 'specialty', 'linkedUid', 'inviteCode', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role in ['manager', 'worker']
        && data.specialty is string && data.specialty.size() <= 100
        && isOptionalId(data.linkedUid)
        && isOptionalInviteCode(data.inviteCode)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlantSchedule(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'name', 'zone', 'category',
          'waterEnabled', 'waterEveryDays', 'lastWateredDate', 'waterAssigneeId', 'waterAssigneeUid',
          'mulchEnabled', 'mulchEveryDays', 'lastMulchedDate', 'mulchAssigneeId', 'mulchAssigneeUid',
          'pruneEnabled', 'pruneEveryDays', 'lastPrunedDate', 'pruneAssigneeId', 'pruneAssigneeUid',
          'receivesFishWater', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'name', 'zone', 'category',
          'waterEnabled', 'waterEveryDays', 'lastWateredDate', 'waterAssigneeId', 'waterAssigneeUid',
          'mulchEnabled', 'mulchEveryDays', 'lastMulchedDate', 'mulchAssigneeId', 'mulchAssigneeUid',
          'pruneEnabled', 'pruneEveryDays', 'lastPrunedDate', 'pruneAssigneeId', 'pruneAssigneeUid',
          'receivesFishWater', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.zone is string && data.zone.size() >= 1 && data.zone.size() <= 60
        && data.category in ['vegetable', 'herb', 'fruit', 'orchard', 'nursery']
        && data.waterEnabled is bool
        && data.waterEveryDays is int && data.waterEveryDays >= 1 && data.waterEveryDays <= 60
        && isOptionalDateString(data.lastWateredDate)
        && isOptionalId(data.waterAssigneeId)
        && isOptionalId(data.waterAssigneeUid)
        && data.mulchEnabled is bool
        && data.mulchEveryDays is int && data.mulchEveryDays >= 1 && data.mulchEveryDays <= 180
        && isOptionalDateString(data.lastMulchedDate)
        && isOptionalId(data.mulchAssigneeId)
        && isOptionalId(data.mulchAssigneeUid)
        && data.pruneEnabled is bool
        && data.pruneEveryDays is int && data.pruneEveryDays >= 1 && data.pruneEveryDays <= 180
        && isOptionalDateString(data.lastPrunedDate)
        && isOptionalId(data.pruneAssigneeId)
        && isOptionalId(data.pruneAssigneeUid)
        && data.receivesFishWater is bool
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFishTank(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'name', 'species', 'capacityLiters', 'intervalDays',
          'currentStage', 'nextDrawdownDate', 'lastDrawdownDate',
          'assigneeId', 'assigneeUid', 'irrigationBedIds', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'name', 'species', 'capacityLiters', 'intervalDays',
          'currentStage', 'nextDrawdownDate', 'lastDrawdownDate',
          'assigneeId', 'assigneeUid', 'irrigationBedIds', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.species is string && data.species.size() >= 1 && data.species.size() <= 80
        && data.capacityLiters is int && data.capacityLiters >= 50 && data.capacityLiters <= 500000
        && data.intervalDays is int && data.intervalDays >= 1 && data.intervalDays <= 14
        && data.currentStage in [1, 2, 3]
        && isDateString(data.nextDrawdownDate)
        && isOptionalDateString(data.lastDrawdownDate)
        && isOptionalId(data.assigneeId)
        && isOptionalId(data.assigneeUid)
        && isValidBoundedIdList(data.irrigationBedIds)
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnimalGroup(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'name', 'animalType', 'count', 'housing', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'name', 'animalType', 'count', 'housing', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.animalType in ['fish', 'chicken', 'duck', 'goat', 'pig', 'cattle', 'other']
        && data.count is int && data.count >= 0 && data.count <= 1000000
        && data.housing is string && data.housing.size() <= 80
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnimalTask(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'animalId', 'animalName', 'animalType', 'taskKind',
          'title', 'everyDays', 'lastDoneDate', 'assigneeId', 'assigneeUid', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'animalId', 'animalName', 'animalType', 'taskKind',
          'title', 'everyDays', 'lastDoneDate', 'assigneeId', 'assigneeUid', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && isOptionalId(data.animalId)
        && data.animalName is string && data.animalName.size() >= 1 && data.animalName.size() <= 80
        && data.animalType in ['fish', 'chicken', 'duck', 'goat', 'pig', 'cattle', 'other']
        && data.taskKind in ['feeding', 'cleaning', 'water_change', 'egg_collection', 'health_check', 'other']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.everyDays is int && data.everyDays >= 1 && data.everyDays <= 180
        && isOptionalDateString(data.lastDoneDate)
        && isOptionalId(data.assigneeId)
        && isOptionalId(data.assigneeUid)
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomTask(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'title', 'category', 'dueDate', 'recurrenceDays',
          'assigneeId', 'assigneeUid', 'status', 'completedDate', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'title', 'category', 'dueDate', 'recurrenceDays',
          'assigneeId', 'assigneeUid', 'status', 'completedDate', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category in ['water', 'mulch', 'prune', 'fish_tank', 'animal', 'harvest', 'maintenance']
        && isDateString(data.dueDate)
        && data.recurrenceDays is int && data.recurrenceDays >= 0 && data.recurrenceDays <= 365
        && isOptionalId(data.assigneeId)
        && isOptionalId(data.assigneeUid)
        && data.status in ['pending', 'completed']
        && isOptionalDateString(data.completedDate)
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompletionLog(data, farmId) {
      return data.keys().hasAll([
          'farmId', 'ownerId', 'dateKey', 'taskType', 'sourceId', 'sourceTitle',
          'assignedMemberId', 'assignedMemberName', 'assignedUid',
          'completedByUid', 'completedByName', 'status',
          'approvalStatus', 'confirmedByUid', 'confirmedByName',
          'waterVolumeLiters', 'tankStage', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmId', 'ownerId', 'dateKey', 'taskType', 'sourceId', 'sourceTitle',
          'assignedMemberId', 'assignedMemberName', 'assignedUid',
          'completedByUid', 'completedByName', 'status',
          'approvalStatus', 'confirmedByUid', 'confirmedByName',
          'waterVolumeLiters', 'tankStage', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.farmId) && data.farmId == farmId
        && isValidId(data.ownerId)
        && isDateString(data.dateKey)
        && data.taskType in ['water', 'mulch', 'prune', 'fish_tank', 'animal', 'custom']
        && isValidId(data.sourceId)
        && data.sourceTitle is string && data.sourceTitle.size() >= 1 && data.sourceTitle.size() <= 120
        && isOptionalId(data.assignedMemberId)
        && data.assignedMemberName is string && data.assignedMemberName.size() >= 1 && data.assignedMemberName.size() <= 80
        && isOptionalId(data.assignedUid)
        && isValidId(data.completedByUid)
        && data.completedByName is string && data.completedByName.size() >= 1 && data.completedByName.size() <= 80
        && data.status == 'done'
        && data.approvalStatus in ['pending_confirmation', 'confirmed']
        && isOptionalId(data.confirmedByUid)
        && data.confirmedByName is string && data.confirmedByName.size() <= 80
        && data.waterVolumeLiters is int && data.waterVolumeLiters >= 0 && data.waterVolumeLiters <= 1000000
        && data.tankStage in ['', '1/4', '2/4', '3/4']
        && data.notes is string && data.notes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /users/{userId} (PII Isolated to Owner Only)
    // =========================================================================

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'activeFarmId', 'activeRole', 'activeMemberId', 'activeFarmName', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // =========================================================================
    // Collection 2: /farmInvites/{inviteCode} (Worker Join Code Exchange)
    // =========================================================================

    match /farmInvites/{inviteCode} {
      // Single-code lookup only (no list scraping)
      allow get: if isVerified() && isInviteCode(inviteCode);
      allow list: if false;
      allow create: if isVerified()
        && isInviteCode(inviteCode)
        && isValidFarmInvite(incoming(), inviteCode)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'open'
        && incoming().claimedByUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isFarmOwner(incoming().farmId);
      allow update: if isVerified()
        && isInviteCode(inviteCode)
        && isValidFarmInvite(incoming(), inviteCode)
        && incoming().code == existing().code
        && incoming().farmId == existing().farmId
        && incoming().ownerId == existing().ownerId
        && incoming().memberId == existing().memberId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'open'
        && incoming().status == 'claimed'
        && incoming().claimedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'updatedAt']);
      allow delete: if isVerified()
        && isInviteCode(inviteCode)
        && existing().ownerId == request.auth.uid;
    }

    // =========================================================================
    // Collection 3: /farms/{farmId}
    // =========================================================================

    match /farms/{farmId} {
      allow get: if isSignedIn() && isValidId(farmId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(farmId)
        && isValidFarm(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(farmId)
        && isValidFarm(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'volumeUnit', 'updatedAt']);
      allow delete: if isVerified()
        && isValidId(farmId)
        && existing().ownerId == request.auth.uid;

      // -----------------------------------------------------------------------
      // Subcollection 3a: /farms/{farmId}/members/{memberId}
      // -----------------------------------------------------------------------
      match /members/{memberId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(memberId)
          && (existing().ownerId == request.auth.uid || existing().linkedUid == request.auth.uid)
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (existing().ownerId == request.auth.uid || existing().linkedUid == request.auth.uid);
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(memberId)
          && isValidFarmMember(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(memberId)
          && isValidFarmMember(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1 Action: Farm Manager edits member or generates invite code
            (
              isFarmOwner(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'role', 'specialty', 'linkedUid', 'inviteCode', 'active', 'updatedAt'
              ])
            )
            // Tier 2 Action: Worker claims open invite code atomically (Pillar 7 getAfter)
            || (
              existing().linkedUid == ''
              && existing().active == true
              && isInviteCode(existing().inviteCode)
              && incoming().linkedUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/farmInvites/$(existing().inviteCode)).data.claimedByUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/farmInvites/$(existing().inviteCode)).data.memberId == memberId
              && getAfter(/databases/$(database)/documents/farmInvites/$(existing().inviteCode)).data.farmId == farmId
              && incoming().diff(existing()).affectedKeys().hasOnly(['linkedUid', 'updatedAt'])
            )
          );
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(memberId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3b: /farms/{farmId}/plants/{plantId}
      // -----------------------------------------------------------------------
      match /plants/{plantId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(plantId)
          && (
            existing().ownerId == request.auth.uid
            || existing().waterAssigneeUid == request.auth.uid
            || existing().mulchAssigneeUid == request.auth.uid
            || existing().pruneAssigneeUid == request.auth.uid
          )
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (
            existing().ownerId == request.auth.uid
            || existing().waterAssigneeUid == request.auth.uid
            || existing().mulchAssigneeUid == request.auth.uid
            || existing().pruneAssigneeUid == request.auth.uid
          );
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(plantId)
          && isValidPlantSchedule(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(plantId)
          && isValidPlantSchedule(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1 Action: Manager full schedule update & confirmation updates
            (
              isFarmOwner(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'zone', 'category',
                'waterEnabled', 'waterEveryDays', 'lastWateredDate', 'waterAssigneeId', 'waterAssigneeUid',
                'mulchEnabled', 'mulchEveryDays', 'lastMulchedDate', 'mulchAssigneeId', 'mulchAssigneeUid',
                'pruneEnabled', 'pruneEveryDays', 'lastPrunedDate', 'pruneAssigneeId', 'pruneAssigneeUid',
                'receivesFishWater', 'notes', 'updatedAt'
              ])
            )
            // Tier 2 Action: Newly linked worker binds their own UID to assigned plant slots
            || (
              farmExists(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'waterAssigneeUid', 'mulchAssigneeUid', 'pruneAssigneeUid', 'updatedAt'
              ])
              && (
                incoming().waterAssigneeUid == existing().waterAssigneeUid
                || (existing().waterAssigneeUid == '' && incoming().waterAssigneeUid == request.auth.uid && isActiveLinkedMember(farmId, existing().waterAssigneeId))
              )
              && (
                incoming().mulchAssigneeUid == existing().mulchAssigneeUid
                || (existing().mulchAssigneeUid == '' && incoming().mulchAssigneeUid == request.auth.uid && isActiveLinkedMember(farmId, existing().mulchAssigneeId))
              )
              && (
                incoming().pruneAssigneeUid == existing().pruneAssigneeUid
                || (existing().pruneAssigneeUid == '' && incoming().pruneAssigneeUid == request.auth.uid && isActiveLinkedMember(farmId, existing().pruneAssigneeId))
              )
            )
          );
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(plantId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3c: /farms/{farmId}/fishTanks/{tankId}
      // -----------------------------------------------------------------------
      match /fishTanks/{tankId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(tankId)
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid)
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid);
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(tankId)
          && isValidFishTank(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(tankId)
          && isValidFishTank(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1 Action: Manager configures fish tank & confirms stage advances
            (
              isFarmOwner(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'species', 'capacityLiters', 'intervalDays',
                'currentStage', 'nextDrawdownDate', 'lastDrawdownDate',
                'assigneeId', 'assigneeUid', 'irrigationBedIds', 'notes', 'updatedAt'
              ])
            )
            // Tier 2 Action: Newly linked worker binds their own UID to assigned tank
            || (
              farmExists(farmId)
              && existing().assigneeUid == ''
              && incoming().assigneeUid == request.auth.uid
              && isActiveLinkedMember(farmId, existing().assigneeId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeUid', 'updatedAt'])
            )
          );
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(tankId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3d: /farms/{farmId}/animals/{animalId}
      // -----------------------------------------------------------------------
      match /animals/{animalId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(animalId)
          && existing().ownerId == request.auth.uid
          && farmExists(farmId);
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(animalId)
          && isValidAnimalGroup(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(animalId)
          && isValidAnimalGroup(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'animalType', 'count', 'housing', 'notes', 'updatedAt'
          ]);
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(animalId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3e: /farms/{farmId}/animalTasks/{taskId}
      // -----------------------------------------------------------------------
      match /animalTasks/{taskId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(taskId)
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid)
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid);
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && isValidAnimalTask(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && isValidAnimalTask(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1 Action: Manager edits animal task or confirms completion
            (
              isFarmOwner(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'animalId', 'animalName', 'animalType', 'taskKind',
                'title', 'everyDays', 'lastDoneDate', 'assigneeId', 'assigneeUid', 'notes', 'updatedAt'
              ])
            )
            // Tier 2 Action: Newly linked worker binds their own UID to assigned animal task
            || (
              farmExists(farmId)
              && existing().assigneeUid == ''
              && incoming().assigneeUid == request.auth.uid
              && isActiveLinkedMember(farmId, existing().assigneeId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeUid', 'updatedAt'])
            )
          );
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3f: /farms/{farmId}/tasks/{taskId}
      // -----------------------------------------------------------------------
      match /tasks/{taskId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(taskId)
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid)
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (existing().ownerId == request.auth.uid || existing().assigneeUid == request.auth.uid);
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && isValidCustomTask(incoming(), farmId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isFarmOwner(farmId);
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && isValidCustomTask(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Tier 1 Action: Manager edits task or confirms completion
            (
              isFarmOwner(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'category', 'dueDate', 'recurrenceDays',
                'assigneeId', 'assigneeUid', 'status', 'completedDate', 'notes', 'updatedAt'
              ])
            )
            // Tier 2 Action: Newly linked worker binds their own UID to assigned task
            || (
              farmExists(farmId)
              && existing().assigneeUid == ''
              && incoming().assigneeUid == request.auth.uid
              && isActiveLinkedMember(farmId, existing().assigneeId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['assigneeUid', 'updatedAt'])
            )
          );
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(taskId)
          && existing().ownerId == request.auth.uid
          && isFarmOwner(farmId);
      }

      // -----------------------------------------------------------------------
      // Subcollection 3g: /farms/{farmId}/completions/{completionId}
      // Worker submissions MUST start as pending_confirmation; Manager confirms
      // to terminal state 'confirmed' (locked against further updates).
      // -----------------------------------------------------------------------
      match /completions/{completionId} {
        allow get: if isSignedIn()
          && isValidId(farmId) && isValidId(completionId)
          && (
            existing().ownerId == request.auth.uid
            || existing().assignedUid == request.auth.uid
            || existing().completedByUid == request.auth.uid
          )
          && farmExists(farmId);
        allow list: if isSignedIn()
          && (
            existing().ownerId == request.auth.uid
            || existing().assignedUid == request.auth.uid
            || existing().completedByUid == request.auth.uid
          );
        allow create: if isVerified()
          && isValidId(farmId) && isValidId(completionId)
          && isValidCompletionLog(incoming(), farmId)
          && incoming().completedByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && farmExists(farmId)
          && incoming().ownerId == getFarm(farmId).ownerId
          && (
            // Manager creates directly confirmed completion (or pending if logging on worker's behalf)
            (
              getFarm(farmId).ownerId == request.auth.uid
              && (
                (incoming().approvalStatus == 'confirmed' && incoming().confirmedByUid == request.auth.uid)
                || (incoming().approvalStatus == 'pending_confirmation' && incoming().confirmedByUid == '')
              )
            )
            // Worker submits completion — strictly forced to pending_confirmation
            || (
              incoming().assignedUid == request.auth.uid
              && incoming().approvalStatus == 'pending_confirmation'
              && incoming().confirmedByUid == ''
              && incoming().confirmedByName == ''
              && isActiveLinkedMember(farmId, incoming().assignedMemberId)
            )
          );
        allow update: if isVerified()
          && isValidId(farmId) && isValidId(completionId)
          && isValidCompletionLog(incoming(), farmId)
          && incoming().farmId == existing().farmId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          // Terminal State Locking: only transition pending_confirmation -> confirmed by Farm Manager
          && isFarmOwner(farmId)
          && existing().approvalStatus == 'pending_confirmation'
          && incoming().approvalStatus == 'confirmed'
          && incoming().confirmedByUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'approvalStatus', 'confirmedByUid', 'confirmedByName', 'updatedAt'
          ]);
        allow delete: if isVerified()
          && isValidId(farmId) && isValidId(completionId)
          && farmExists(farmId)
          && (
            existing().ownerId == request.auth.uid
            || (
              existing().completedByUid == request.auth.uid
              && existing().approvalStatus == 'pending_confirmation'
            )
          );
      }
    }
  }
}
